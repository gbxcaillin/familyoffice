# Copy to .env.production on the server and fill in real values.
# Generate a JWT secret:      openssl rand -base64 48
# Generate a password hash:   see DEPLOY.md step 6

JWT_SECRET=replace-with-long-random-string
USER1_NAME=Caillin
USER1_PASSWORD_HASH=replace-with-bcrypt-hash
USER2_NAME=Partner
USER2_PASSWORD_HASH=replace-with-bcrypt-hash

# "Ask your money" assistant (Claude Agent SDK).
# Uses your Claude subscription — NOT the pay-per-token API.
# Generate once on any machine logged into your Claude plan:
#     npx @anthropic-ai/claude-code setup-token
# then paste the token below. Leave ANTHROPIC_API_KEY UNSET so the
# subscription token is used (an API key would take priority and bill per token).
CLAUDE_CODE_OAUTH_TOKEN=replace-with-setup-token
# Optional: pin a model (only if your plan allows it), e.g. claude-sonnet-5
# AGENT_MODEL=

# Email reports (optional). When Claude has to rescue something the built-in
# code couldn't do (e.g. an unrecognised import), a report is emailed here so
# the underlying parser can be improved. Reports are always saved in the DB;
# email is sent only if SMTP is configured below. Use any mailbox's SMTP
# (your gbxps.com host, or a Gmail app password, etc.).
# REPORT_EMAIL defaults to cc@gbxps.com.
# REPORT_EMAIL=cc@gbxps.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM=Family Office <noreply@gbxps.com>
